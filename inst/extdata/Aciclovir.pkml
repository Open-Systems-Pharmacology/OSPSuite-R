              <Map s="f_water_int" id="6" />
              <Map s="Organism|Vf (water,plasma)" id="7" />
              <Map s="f_water_pls" id="8" />
              <Map s="FIRST_NEIGHBOR|&lt;NBH&gt;|FIRST_NEIGHBOR|..|Plasma|&lt;NBH&gt;|MOLECULE|Partition coefficient (interstitial/plasma)" id="9" />
