                      <Parameter id="urbOuYxhRkOpoIiA8wRqOg" name="Surface integration factor" description="The empirical, API/formulation-specific ε [cm] that reduces particle regrowth when bulk concentrations exceed solubility (precipitation)." icon="Parameter" persistable="0" isFixedValue="0" dim="Length" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="0" displayUnit="µm">
