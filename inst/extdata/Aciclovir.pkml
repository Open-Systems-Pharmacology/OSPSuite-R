        <CoreCalculationMethod name="Interstitial partition coefficient method - Schmitt" icon="CoreCalculationMethod" bbVersion="0" category="DistributionInterstitial">
          <Creation createdAt="5250929872106398593" createdBy="pavel.balazki" creationMode="New" origin="Other" />
          <OutputFormulas>
            <KeyValue>
              <Formula id="Interstitial partition coefficient method - Schmitt.PARAM_K_int_pls" name="PARAM_K_int_pls" formula="(f_water_int + f_proteins_int_to_pls * (1/fu - f_water_pls)) * fu">
                <Paths>
                  <Path path="0" as="1" dim="2" />
                  <Path path="3" as="4" />
                  <Path path="5" as="6" />
                  <Path path="7" as="8" />
                </Paths>
              </Formula>
              <ParameterDescriptor parameterName="Partition coefficient (interstitial/plasma)">
                <ContainerCriteria operator="And">
                  <DescriptorConditions>
                    <MatchTagCondition tag="Neighborhood: Plasma / Interstitial" />
                  </DescriptorConditions>
                </ContainerCriteria>
              </ParameterDescriptor>
            </KeyValue>
          </OutputFormulas>
          <HelpParameters>
            <KeyValue>
              <Parameter id="lL1M7tTjt0eo6TtJxZ1Rfw" name="Partition coefficient (interstitial/water)" icon="Parameter" persistable="0" isFixedValue="0" quantityType="Parameter" negativeValuesAllowed="1" formula="Interstitial partition coefficient method - Schmitt.PARAM_K_water_int_Schmitt" isDefault="1">
                <Info min="0" flag="52" seq="1" ref="0" bb="2" group="117" />
              </Parameter>
              <DescriptorCriteria operator="And">
                <DescriptorConditions>
                  <MatchTagCondition tag="Neighborhood: Interstitial / Intracellular" />
                </DescriptorConditions>
              </DescriptorCriteria>
            </KeyValue>
          </HelpParameters>
          <FormulaCache>
            <Formulas>
              <Formula id="Interstitial partition coefficient method - Schmitt.PARAM_K_water_int_Schmitt" name="PARAM_K_water_int_Schmitt" formula="fu/K_int_pls">
                <Paths>
                  <Path path="0" as="1" dim="2" />
                  <Path path="9" as="10" />
                </Paths>
              </Formula>
            </Formulas>
            <StringMap>
              <Map s="MOLECULE|Fraction unbound (plasma)" id="0" />
              <Map s="fu" id="1" />
              <Map s="Fraction" id="2" />
              <Map s="Organism|Protein ratio (interstial/plasma)" id="3" />
              <Map s="f_proteins_int_to_pls" id="4" />
              <Map s="Organism|Vf (water,interstitial)" id="5" />
              <Map s="f_water_int" id="6" />
              <Map s="Organism|Vf (water,plasma)" id="7" />
              <Map s="f_water_pls" id="8" />
              <Map s="FIRST_NEIGHBOR|&lt;NBH&gt;|FIRST_NEIGHBOR|..|Plasma|&lt;NBH&gt;|MOLECULE|Partition coefficient (interstitial/plasma)" id="9" />
