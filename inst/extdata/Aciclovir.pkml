                      <Parameter id="x8ZX1R4430q2y3SIiSoFtQ" name="Diffusion layer thickness exponent" description="Shape parameter in the theoretical relation governing how diffusion-layer thickness scales between unbound and bound drug." icon="Parameter" persistable="0" isFixedValue="0" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="0.333333333">
