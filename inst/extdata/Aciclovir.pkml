              </Formula>
              <ParameterDescriptor parameterName="Partition coefficient (blood cells/plasma)">
                <ContainerCriteria operator="And">
                  <DescriptorConditions>
                    <MatchTagCondition tag="RootContainer" />
                  </DescriptorConditions>
                </ContainerCriteria>
              </ParameterDescriptor>
            </KeyValue>
            <KeyValue>
              <Formula id="Cellular partition coefficient method - PK-Sim Standard.PARAM_K_cell_pls_PK-Sim_Standard" name="PARAM_K_cell_pls_PK-Sim_Standard" formula="(f_water + f_lipids * 10^LogMA + f_proteins * KProt) * fu">
                <Paths>
                  <Path path="0" as="1" dim="2" />
                  <Path path="3" as="4" dim="5" />
                  <Path path="6" as="7" />
                  <Path path="14" as="15" />
                  <Path path="16" as="17" />
                  <Path path="18" as="19" />
