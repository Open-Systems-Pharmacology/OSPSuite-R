              <Parameter id="iT9VChs17ku-ZvQdHpT2lQ" name="kass (FcRn)" description="Association constant of drug for binding to FcRn" icon="Parameter" persistable="0" isFixedValue="0" dim="Second order rate constant" quantityType="Parameter" negativeValuesAllowed="1" buildMode="Global" isDefault="1" value="0.87" displayUnit="l/µmol/min">
