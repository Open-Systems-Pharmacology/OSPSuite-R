<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

   <ItemGroup>
      <PackageReference Include="MoBi.R" Version="13.0.121" />
      <PackageReference Include="PKSim.R" Version="13.0.81" GeneratePathProperty="true" />
      <PackageReference Include="OSPSuite.FuncParser" Version="5.0.0.3" />
      <PackageReference Include="OSPSuite.SimModel" Version="5.0.0.76" />
      <PackageReference Include="OSPSuite.SimModelSolver_CVODES" Version="5.0.0.53" />
   </ItemGroup>

   <ItemGroup>
      <Content Include="$(PkgPKSim_R)\OSPSuite.Dimensions.xml" Link="OSPSuite.Dimensions.xml">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="$(PkgPKSim_R)\OSPSuite.PKParameters.xml" Link="OSPSuite.PKParameters.xml">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="$(PkgPKSim_R)\PKSimDB.sqlite" Link="PKSimDB.sqlite">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
   </ItemGroup>
   <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
     <IsPublishable>True</IsPublishable>
   </PropertyGroup>

   <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
     <IsPublishable>True</IsPublishable>
   </PropertyGroup>

   <!--
     Allow-list of *.dll filenames (without extension) permitted in inst/lib.
     The PostBuild target deletes any inst/lib *.dll whose name is not here, so
     a new upstream transitive dependency surfaces as a test-time
     FileNotFoundException rather than silently bloating the package.
     Remove an entry to drop a DLL from the shipped set. See issue #1587.
   -->
   <ItemGroup>
      <AllowedAssembly Include="Antlr3.Runtime" />
      <AllowedAssembly Include="Autofac" />
      <AllowedAssembly Include="Castle.Core" />
      <AllowedAssembly Include="Castle.Windsor" />
      <AllowedAssembly Include="FluentNHibernate" />
      <AllowedAssembly Include="ICSharpCode.SharpZipLib" />
      <AllowedAssembly Include="Iesi.Collections" />
      <AllowedAssembly Include="LumenWorks.Framework.IO" />
      <AllowedAssembly Include="MarkdownLog" />
      <AllowedAssembly Include="Microsoft.Data.Sqlite" />
      <AllowedAssembly Include="Microsoft.Extensions.DependencyInjection" />
      <AllowedAssembly Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
      <AllowedAssembly Include="Microsoft.Extensions.Logging" />
      <AllowedAssembly Include="Microsoft.Extensions.Logging.Abstractions" />
      <AllowedAssembly Include="Microsoft.Extensions.Options" />
      <AllowedAssembly Include="MoBi.Assets" />
      <AllowedAssembly Include="MoBi.CLI.Core" />
      <AllowedAssembly Include="MoBi.Core" />
      <AllowedAssembly Include="MoBi.R" />
      <AllowedAssembly Include="NHibernate" />
      <AllowedAssembly Include="NHibernate.Extensions.Sqlite" />
      <AllowedAssembly Include="NPOI.Core" />
      <AllowedAssembly Include="NPOI.OOXML" />
      <AllowedAssembly Include="NPOI.OpenXml4Net" />
      <AllowedAssembly Include="NPOI.OpenXmlFormats" />
      <AllowedAssembly Include="Newtonsoft.Json" />
      <AllowedAssembly Include="Newtonsoft.Json.Schema" />
      <AllowedAssembly Include="OSPSuite.Assets" />
      <AllowedAssembly Include="OSPSuite.Assets.Images" />
      <AllowedAssembly Include="OSPSuite.CLI.Core" />
      <AllowedAssembly Include="OSPSuite.Core" />
      <AllowedAssembly Include="OSPSuite.FuncParser" />
      <AllowedAssembly Include="OSPSuite.FuncParserNative" />
      <AllowedAssembly Include="OSPSuite.Infrastructure" />
      <AllowedAssembly Include="OSPSuite.Infrastructure.Autofac" />
      <AllowedAssembly Include="OSPSuite.Infrastructure.Castle" />
      <AllowedAssembly Include="OSPSuite.Infrastructure.Export" />
      <AllowedAssembly Include="OSPSuite.Infrastructure.Import" />
      <AllowedAssembly Include="OSPSuite.Infrastructure.Serialization" />
      <AllowedAssembly Include="OSPSuite.R" />
      <AllowedAssembly Include="OSPSuite.Serializer" />
      <AllowedAssembly Include="OSPSuite.SimModel" />
      <AllowedAssembly Include="OSPSuite.SimModelNative" />
      <AllowedAssembly Include="OSPSuite.SimModelSolver_CVODES" />
      <AllowedAssembly Include="OSPSuite.Utility" />
      <AllowedAssembly Include="PKSim.Assets" />
      <AllowedAssembly Include="PKSim.CLI.Core" />
      <AllowedAssembly Include="PKSim.Core" />
      <AllowedAssembly Include="PKSim.Infrastructure" />
      <AllowedAssembly Include="PKSim.R" />
      <AllowedAssembly Include="Remotion.Linq" />
      <AllowedAssembly Include="Remotion.Linq.EagerFetching" />
      <AllowedAssembly Include="SQLitePCLRaw.batteries_v2" />
      <AllowedAssembly Include="SQLitePCLRaw.core" />
      <AllowedAssembly Include="SQLitePCLRaw.provider.e_sqlite3" />
      <AllowedAssembly Include="System.Configuration.ConfigurationManager" />
      <AllowedAssembly Include="System.Formats.Nrbf" />
      <AllowedAssembly Include="ZString" />
      <AllowedAssembly Include="e_sqlite3" />
   </ItemGroup>

   <Target Name="PostBuild" AfterTargets="PostBuildEvent">
      <ItemGroup>
         <AssemblyFiles Include="$(TargetDir)*.dll;$(TargetDir)\runtimes\win-x64\native\*.dll" />
         <NativeMacFiles Include="$(TargetDir)\runtimes\osx-arm64\native\*.dylib" />
         <NativeLinuxFiles Include="$(TargetDir)\runtimes\linux-x64\native\*.so" />
         <ConfigFiles Include="$(TargetDir)OSPSuite.*.xml" />
         <PKSimDataBaseFile Include="$(TargetDir)PKSimDB.sqlite" />
      </ItemGroup>
      <Copy SourceFiles="@(AssemblyFiles); @(NativeMacFiles); @(NativeLinuxFiles); @(ConfigFiles); @(PKSimDataBaseFile)" DestinationFolder="$(SolutionDir)..\..\inst\lib\" />

      <!-- Allow-list enforcement: delete any inst/lib binary (managed *.dll OR
           native *.so / *.dylib) whose name is not in @(AllowedAssembly).
           Native files follow the Unix lib<Name>.so / lib<Name>.dylib convention. -->
      <ItemGroup>
         <_Shipped Include="$(SolutionDir)..\..\inst\lib\*.dll;$(SolutionDir)..\..\inst\lib\*.so;$(SolutionDir)..\..\inst\lib\*.dylib" />
         <_AllowedPath Include="@(AllowedAssembly->'$(SolutionDir)..\..\inst\lib\%(Identity).dll')" />
         <_AllowedPath Include="@(AllowedAssembly->'$(SolutionDir)..\..\inst\lib\lib%(Identity).so')" />
         <_AllowedPath Include="@(AllowedAssembly->'$(SolutionDir)..\..\inst\lib\lib%(Identity).dylib')" />
         <_Denied Include="@(_Shipped)" Exclude="@(_AllowedPath)" />
      </ItemGroup>
      <Message Importance="high" Text="Allow-list sweep: deleting %(_Denied.Filename)%(_Denied.Extension)" Condition="'@(_Denied)' != ''" />
      <Delete Files="@(_Denied)" />
   </Target>
</Project>
