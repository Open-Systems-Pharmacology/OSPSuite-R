<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

   <ItemGroup>
      <PackageReference Include="MoBi.R" Version="13.0.0-yxvIY" />
      <PackageReference Include="PKSim.R" Version="13.0.64" GeneratePathProperty="true" />
      <PackageReference Include="OSPSuite.FuncParser" Version="4.0.0.76" GeneratePathProperty="true" />
      <PackageReference Include="OSPSuite.FuncParser.Ubuntu22" Version="4.0.0.76" GeneratePathProperty="true" />
      <PackageReference Include="OSPSuite.FuncParser.MacOS.Arm64" Version="4.0.0.76" GeneratePathProperty="true" />
      <PackageReference Include="OSPSuite.SimModel" Version="4.0.0.79" GeneratePathProperty="true" />
      <PackageReference Include="OSPSuite.SimModel.Ubuntu22" Version="4.0.0.79" GeneratePathProperty="true" />
      <PackageReference Include="OSPSuite.SimModel.MacOS.Arm64" Version="4.0.0.79" GeneratePathProperty="true" />
      <PackageReference Include="OSPSuite.SimModelSolver_CVODES" Version="4.1.0.19" GeneratePathProperty="true" />
      <PackageReference Include="OSPSuite.SimModelSolver_CVODES.Ubuntu22" Version="4.1.0.19" GeneratePathProperty="true" />
      <PackageReference Include="OSPSuite.SimModelSolver_CVODES.MacOSArm64" Version="4.1.0.19" GeneratePathProperty="true" />
   </ItemGroup>

   <ItemGroup>
      <Content Include="$(PkgPKSim_R)\OSPSuite.Dimensions.xml" Link="OSPSuite.Dimensions.xml">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="$(PkgPKSim_R)\OSPSuite.PKParameters.xml" Link="OSPSuite.PKParameters.xml">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="$(PkgPKSim_R)\PKSimDB.sqlite" Link="PKSimDB.sqlite">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>

      <Content Include="$(PkgOSPSuite_FuncParser)\OSPSuite.FuncParserNative\bin\native\x64\Release\OSPSuite.FuncParserNative.dll" Link="OSPSuite.FuncParserNative.dll">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="$(PkgOSPSuite_FuncParser_Ubuntu22)\OSPSuite.FuncParserNative\bin\native\x64\Release\libOSPSuite.FuncParserNative.so" Link="libOSPSuite.FuncParserNative.so">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>

      <Content Include="$(PkgOSPSuite_SimModel)\OSPSuite.SimModelNative\bin\native\x64\Release\OSPSuite.SimModelNative.dll" Link="OSPSuite.SimModelNative.dll">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="$(PkgOSPSuite_SimModel_Ubuntu22)\OSPSuite.SimModelNative\bin\native\x64\Release\libOSPSuite.SimModelNative.so" Link="libOSPSuite.SimModelNative.so">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>

      <Content Include="$(PkgOSPSuite_SimModelSolver_CVODES)\OSPSuite.SimModelSolver_CVODES\bin\native\x64\Release\OSPSuite.SimModelSolver_CVODES.dll" Link="OSPSuite.SimModelSolver_CVODES.dll">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="$(PkgOSPSuite_SimModelSolver_CVODES_Ubuntu22)\OSPSuite.SimModelSolver_CVODES\bin\native\x64\Release\libOSPSuite.SimModelSolver_CVODES.so" Link="libOSPSuite.SimModelSolver_CVODES.so">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
   </ItemGroup>
   <ItemGroup>
      <Content Include="$(PkgOSPSuite_FuncParser_MacOS_Arm64)\OSPSuite.FuncParserNative\bin\native\Arm64\Release\libOSPSuite.FuncParserNative.dylib" Link="libOSPSuite.FuncParserNative.dylib">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="$(PkgOSPSuite_SimModel_MacOS_Arm64)\OSPSuite.SimModelNative\bin\native\Arm64\Release\libOSPSuite.SimModelNative.dylib" Link="libOSPSuite.SimModelNative.dylib">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="$(PkgOSPSuite_SimModelSolver_CVODES_MacOSArm64)\OSPSuite.SimModelSolver_CVODES\bin\native\Arm64\Release\libOSPSuite.SimModelSolver_CVODES.dylib" Link="libOSPSuite.SimModelSolver_CVODES.dylib">
         <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
   </ItemGroup>
   <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
     <IsPublishable>True</IsPublishable>
   </PropertyGroup>

   <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
     <IsPublishable>True</IsPublishable>
   </PropertyGroup>

   <!--
     Allow-list of *.dll filenames (without extension) permitted in inst/lib.
     The PostBuild target deletes any inst/lib *.dll whose name is not here, so
     a new upstream transitive dependency surfaces as a test-time
     FileNotFoundException rather than silently bloating the package.
     Remove an entry to drop a DLL from the shipped set. See issue #1587.
   -->
   <ItemGroup>
      <AllowedAssembly Include="Antlr3.Runtime" />
      <AllowedAssembly Include="Autofac" />
      <AllowedAssembly Include="BouncyCastle.Cryptography" />
      <AllowedAssembly Include="Castle.Core" />
      <AllowedAssembly Include="Castle.Windsor" />
      <AllowedAssembly Include="DependencyManager" />
      <AllowedAssembly Include="DevExpress.Data.v21.2" />
      <AllowedAssembly Include="ExtendedNumerics.BigDecimal" />
      <AllowedAssembly Include="FluentNHibernate" />
      <AllowedAssembly Include="ICSharpCode.SharpZipLib" />
      <AllowedAssembly Include="Iesi.Collections" />
      <AllowedAssembly Include="LumenWorks.Framework.IO" />
      <AllowedAssembly Include="MarkdownLog" />
      <AllowedAssembly Include="Microsoft.Data.Sqlite" />
      <AllowedAssembly Include="Microsoft.Extensions.DependencyInjection" />
      <AllowedAssembly Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
      <AllowedAssembly Include="Microsoft.Extensions.Logging" />
      <AllowedAssembly Include="Microsoft.Extensions.Logging.Abstractions" />
      <AllowedAssembly Include="Microsoft.Extensions.Options" />
      <AllowedAssembly Include="MoBi.Assets" />
      <AllowedAssembly Include="MoBi.CLI.Core" />
      <AllowedAssembly Include="MoBi.Core" />
      <AllowedAssembly Include="MoBi.Presentation" />
      <AllowedAssembly Include="MoBi.R" />
      <AllowedAssembly Include="NHibernate" />
      <AllowedAssembly Include="NHibernate.Extensions.Sqlite" />
      <AllowedAssembly Include="NPOI.Core" />
      <AllowedAssembly Include="NPOI.OOXML" />
      <AllowedAssembly Include="NPOI.OpenXml4Net" />
      <AllowedAssembly Include="NPOI.OpenXmlFormats" />
      <AllowedAssembly Include="Newtonsoft.Json" />
      <AllowedAssembly Include="Newtonsoft.Json.Schema" />
      <AllowedAssembly Include="OSPSuite.Assets" />
      <AllowedAssembly Include="OSPSuite.Assets.Images" />
      <AllowedAssembly Include="OSPSuite.CLI.Core" />
      <AllowedAssembly Include="OSPSuite.Core" />
      <AllowedAssembly Include="OSPSuite.FuncParser" />
      <AllowedAssembly Include="OSPSuite.FuncParserNative" />
      <AllowedAssembly Include="OSPSuite.Infrastructure" />
      <AllowedAssembly Include="OSPSuite.Infrastructure.Autofac" />
      <AllowedAssembly Include="OSPSuite.Infrastructure.Castle" />
      <AllowedAssembly Include="OSPSuite.Infrastructure.Export" />
      <AllowedAssembly Include="OSPSuite.Infrastructure.Import" />
      <AllowedAssembly Include="OSPSuite.Infrastructure.Serialization" />
      <AllowedAssembly Include="OSPSuite.Presentation" />
      <AllowedAssembly Include="OSPSuite.Presentation.Serialization" />
      <AllowedAssembly Include="OSPSuite.R" />
      <AllowedAssembly Include="OSPSuite.Serializer" />
      <AllowedAssembly Include="OSPSuite.SimModel" />
      <AllowedAssembly Include="OSPSuite.SimModelNative" />
      <AllowedAssembly Include="OSPSuite.SimModelSolver_CVODES" />
      <AllowedAssembly Include="OSPSuite.TeXReporting" />
      <AllowedAssembly Include="OSPSuite.Utility" />
      <AllowedAssembly Include="PKSim.Assets" />
      <AllowedAssembly Include="PKSim.CLI.Core" />
      <AllowedAssembly Include="PKSim.Core" />
      <AllowedAssembly Include="PKSim.Infrastructure" />
      <AllowedAssembly Include="PKSim.Presentation" />
      <AllowedAssembly Include="PKSim.R" />
      <AllowedAssembly Include="Remotion.Linq" />
      <AllowedAssembly Include="Remotion.Linq.EagerFetching" />
      <AllowedAssembly Include="SQLitePCLRaw.batteries_v2" />
      <AllowedAssembly Include="SQLitePCLRaw.core" />
      <AllowedAssembly Include="SQLitePCLRaw.provider.e_sqlite3" />
      <AllowedAssembly Include="SixLabors.Fonts" />
      <AllowedAssembly Include="SixLabors.ImageSharp" />
      <AllowedAssembly Include="System.Configuration.ConfigurationManager" />
      <AllowedAssembly Include="System.Drawing.Common" />
      <AllowedAssembly Include="ZString" />
      <AllowedAssembly Include="e_sqlite3" />
   </ItemGroup>

   <Target Name="PostBuild" AfterTargets="PostBuildEvent">
      <ItemGroup>
         <AssemblyFiles Include="$(TargetDir)*.dll;$(TargetDir)\runtimes\win-x64\native\*.dll" />
         <NativeMacFiles Include="$(TargetDir)*.dylib" />
         <NativeLinuxFiles Include="$(TargetDir)*.so" />
         <ConfigFiles Include="$(TargetDir)OSPSuite.*.xml" />
         <PKSimDataBaseFile Include="$(TargetDir)PKSimDB.sqlite" />
      </ItemGroup>
      <Copy SourceFiles="@(AssemblyFiles); @(NativeMacFiles); @(NativeLinuxFiles); @(ConfigFiles); @(PKSimDataBaseFile)" DestinationFolder="$(SolutionDir)..\..\inst\lib\" />
      <Copy SourceFiles="$(TargetDir)\runtimes\linux-x64\native\libe_sqlite3.so" DestinationFiles="$(SolutionDir)..\..\inst\lib\libe_sqlite3.so" />
      <Copy SourceFiles="$(TargetDir)\runtimes\osx-arm64\native\libe_sqlite3.dylib" DestinationFiles="$(SolutionDir)..\..\inst\lib\libe_sqlite3.dylib" />

      <!-- Allow-list enforcement: delete any inst/lib *.dll whose name is not in @(AllowedAssembly). -->
      <ItemGroup>
         <_ShippedDll Include="$(SolutionDir)..\..\inst\lib\*.dll" />
         <_AllowedPath Include="@(AllowedAssembly->'$(SolutionDir)..\..\inst\lib\%(Identity).dll')" />
         <_DeniedDll Include="@(_ShippedDll)" Exclude="@(_AllowedPath)" />
      </ItemGroup>
      <Message Importance="high" Text="Allow-list sweep: deleting %(_DeniedDll.Filename)%(_DeniedDll.Extension)" Condition="'@(_DeniedDll)' != ''" />
      <Delete Files="@(_DeniedDll)" />
   </Target>
</Project>
